{
  "manifest_version": 3,
  "name": "RT Recording v2 (test shell)",
  "version": "0.0.1",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["recording-content.js"], "run_at": "document_start" }
  ]
}
